# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with: python scripts/generate_secrets.py

FG_ENVIRONMENT=dev              # dev | staging | prod
FG_LOG_LEVEL=INFO

# --- secrets (required in prod) ---
FG_FIELD_ENCRYPTION_KEY=
FG_JWT_SECRET=
FG_HMAC_SIGNING_SECRET=

# --- model integrity ---
FG_MODEL_PATH=artifacts/model.joblib
FG_MODEL_SHA256=               # printed by scripts/train_model.py; required in prod
FG_REVIEW_THRESHOLD=0.30

# --- transport ---
FG_REQUIRE_HTTPS=true
FG_ALLOWED_ORIGINS=["https://dashboard.internal.example.com"]
FG_TRUSTED_HOSTS=["api.internal.example.com"]

# --- throughput ---
FG_RATE_LIMIT_PER_MINUTE=120
FG_REDIS_URL=redis://localhost:6379/0
